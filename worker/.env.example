# Server-side API bearer secret; use the same random value in LeadForge.
LEADFORGE_WORKER_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
LEADFORGE_WORKER_HOST=0.0.0.0
LEADFORGE_WORKER_PORT=8080
LEADFORGE_ARTIFACT_DIR=/data/artifacts

# Default false. Network collection requires this AND LeadForge's
# LEADFORGE_SCRAPER_LIVE_COLLECTION_ENABLED=true.
LEADFORGE_WORKER_LIVE_COLLECTION_ENABLED=false
